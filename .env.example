# Copy to `.env` and fill in real values. Never commit a filled-in `.env`.
# Every variable read by src/server/config/env.server.ts and
# src/shared/config/env.ts is documented here.

# --- Database (server only) -------------------------------------------------
# Pooled connection used by the app at request time. On Neon/Supabase this is
# the pgbouncer endpoint; `connection_limit=1` is required for serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection. Used only by `prisma migrate` / `prisma studio`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- Auth (server only) -----------------------------------------------------
# HS256 signing key for the rb_session JWT. Must be >= 32 characters.
# Generate with: openssl rand -base64 48
# Rotating this invalidates every existing session.
AUTH_JWT_SECRET="replace-me-with-at-least-32-random-characters"
# Session lifetime in seconds. Defaults to 7 days when unset.
AUTH_SESSION_TTL_SECONDS="604800"
# Optional salt for hashing client IPs before they are written to AuthAttempt.
# Falls back to AUTH_JWT_SECRET when unset.
AUTH_IP_HASH_SALT=""

# --- Telegram login (server only) -------------------------------------------
# Bot token from @BotFather. This is the entire security boundary for Telegram
# login: the HMAC key is SHA256(this value). Leave empty to disable Telegram auth.
TELEGRAM_BOT_TOKEN=""

# --- Bootstrap admin, consumed by prisma/seed.ts (server only) --------------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="replace-me-before-seeding"

# --- AI providers (server only) ---------------------------------------------
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Upper bound on tokens sent to an AI provider per request. Defaults to 5000.
MAX_AI_TOKENS="5000"

# --- Basic Resume, the voice-guided CV (server only) ------------------------
# Feature flag for the whole basic-CV product line. Off unless set to exactly
# "true"; with it off no entry point is reachable and the API routes refuse.
BASIC_RESUME_ENABLED="false"

# --- Payments (server only) --------------------------------------------------
# Guards GET /api/cron/payments-reconcile. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET`. Leave empty to disable the route (it
# then 404s rather than running unauthenticated); the reconcile cron is a safety
# net, not a correctness requirement.
CRON_SECRET=""
# How long a payment order / QR stays valid. Defaults to 600 (10 minutes).
PAYMENT_ORDER_TTL_SECONDS="600"
# Server-side debounce between provider status checks for one order, in ms.
PAYMENT_SYNC_DEBOUNCE_MS="2500"

# Registers the MockProvider so the full top-up flow is demoable without Bakong
# credentials. IGNORED in production: the provider module throws at load time if
# NODE_ENV === 'production'.
PAYMENTS_MOCK_ENABLED="true"
# Seconds after which a mock order auto-transitions to PAID. 0 (default) means
# only the explicit POST /api/payments/orders/[id]/mock-pay endpoint pays it.
PAYMENTS_MOCK_AUTOPAY_SECONDS="0"

# --- Bakong / KHQR (server only) ---------------------------------------------
# Bakong is only offered to users once ACCESS_TOKEN and ACCOUNT_ID are both set;
# until then isConfigured() returns false and the provider is never listed.
BAKONG_API_BASE_URL="https://api-bakong.nbc.gov.kh"
# Developer token from Bakong. EXPIRES ROUGHLY EVERY 90 DAYS and renewal needs a
# registered email, so it cannot be rotated automatically. When it expires,
# status checks return 503 and orders stay PENDING until it is replaced.
BAKONG_ACCESS_TOKEN=""
# Bakong account id, e.g. "your_name@wing".
BAKONG_ACCOUNT_ID=""
BAKONG_MERCHANT_NAME="Resume Builder"
BAKONG_MERCHANT_CITY="Phnom Penh"
# Set BOTH to issue merchant-type KHQR; leave both empty for individual-type.
BAKONG_MERCHANT_ID=""
BAKONG_ACQUIRING_BANK=""
# Optional KHQR fields.
BAKONG_MOBILE_NUMBER=""
BAKONG_STORE_LABEL=""
BAKONG_TERMINAL_LABEL=""
BAKONG_REQUEST_TIMEOUT_MS="10000"

# --- Public (inlined into the client bundle - never put secrets here) --------
# Bot username, without the leading @, used to render the Telegram login widget.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Canonical origin of the deployment, e.g. https://cv.example.com
NEXT_PUBLIC_APP_URL="http://localhost:3001"
