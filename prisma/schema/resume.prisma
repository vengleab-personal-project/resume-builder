// Which product line a row belongs to. The two kinds share this table because a
// resume is one JSON blob either way, but they are different documents with
// different fields, different templates and different editors -- so every query
// has to say which kind it wants. FULL is the default so pre-existing rows, and
// any caller written before BASIC existed, keep their current meaning.
enum ResumeKind {
  FULL
  BASIC
}

model Resume {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String @default("Untitled Resume")

  kind ResumeKind @default(FULL)

  // The editor's ResumeData / ThemeConfig shapes are stored verbatim as JSON.
  // Normalising the 11 sections into tables would force a rewrite of the whole
  // editor for no query benefit: a resume is only ever read and written whole.
  // For kind = BASIC this holds BasicResumeData instead, which is why nothing
  // may read `data` without having first established the row's kind.
  data         Json
  sectionOrder Json
  theme        Json

  isDefault Boolean @default(false)

  // Optimistic concurrency token. Autosave PATCHes compare-and-swap on it, so
  // two open tabs can never silently last-write-wins over each other.
  version Int @default(1)

  // Soft delete: evaluation history references resumes, and a hard delete would
  // orphan the record a user is still looking at.
  deletedAt DateTime?

  evaluations EvaluationResult[]
  voiceSessions VoiceInterviewSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deletedAt, updatedAt])
  @@index([userId, kind, deletedAt, updatedAt])
}

enum VoiceSessionStatus {
  ACTIVE
  COMPLETED
  // Ran out of turns. The CV is finalised with whatever was collected, which is
  // a worse outcome than COMPLETED but is never a lost interview.
  EXHAUSTED
  EXPIRED
}

// One spoken interview. Exists as a row rather than as fields on the resume
// because the caps in it are the cost control: a single VOICE_INTERVIEW coin
// debit covers the whole session, so the server has to be able to count turns
// and expire the session without trusting anything the client sends.
//
// Deliberately holds no audio and no transcripts. Extracted answers live in the
// resume, where the user can see and correct them; the recordings are biometric
// data this app has no consent flow or retention policy for, so they are
// processed in memory and dropped.
model VoiceInterviewSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  // 'en' | 'km'. Chosen at session start, not inferred from the UI locale -- a
  // user may read the English UI and prefer to speak Khmer.
  locale String

  // Cursor into BASIC_INTERVIEW_SCRIPT. NULL means "not started"; a value the
  // current script does not contain restarts rather than dead-ends.
  questionId   String?
  // At most one clarifying re-ask per question (§5.3), so the interview always
  // terminates.
  followUpUsed Boolean @default(false)
  turnCount    Int     @default(0)

  status VoiceSessionStatus @default(ACTIVE)

  // The CoinTransaction this session was charged on, so a session that dies
  // before delivering its first question can be refunded rather than silently
  // keeping the coins.
  deductionTxId String?

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // "One active session per user" is a partial unique index, which Prisma
  // cannot express; it is hand-appended to the migration instead.
  @@index([userId, status])
  @@index([resumeId])
}

model EvaluationResult {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  jobDescription String

  // The full EvaluationResponse the route returned, unchanged.
  result Json

  // The resume exactly as it was scored. Without it, editing the resume later
  // would silently invalidate every historical evaluation.
  resumeSnapshot Json?

  modelId String?

  // True when the score came from the heuristic path (no API key, or the model
  // call threw) rather than from a real model run.
  isFallback Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resumeId, createdAt])
}
